extern s16 gRecordNameEnteredLength;
extern s16 sEnterKeyboardIndex;
extern s16 sKeyboardCursorX;
extern s16 sKeyboardCursorY;
extern struct KeyboardObject sKeyboardObjects[50];
extern signed char sNameEntryStr[11];
extern signed char sNameKeyboardCharacters[51];
extern s16 sPreviousRecordsEntryNameEntryState;
extern s16 sRecordsEntryBestLapWordsLeftOffset;
extern s16 sRecordsEntryBestLapWordsTopOffset;
extern s16 sRecordsEntryBestTimeLeft;
extern s16 sRecordsEntryBestTimeTop;
extern u16 sRecordsEntryFlags;
extern u16 sRecordsEntryIncreaseState;
extern s32 sRecordsEntryMaxSpeedLeft;
extern s32 sRecordsEntryMaxSpeedTop;
extern s32 sRecordsEntryMaxSpeedTopMachineOffset;
extern s16 sRecordsEntryNameEntryState;
extern s16 sRecordsEntryNameEntryTransitionTimer;
extern s32 sRecordsEntryRecordHeight;
